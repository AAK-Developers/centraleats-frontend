# Loaded by Vite when running: vite --mode electron
# Used for electron:dev (development against QA backend)
#
# NOTE: The remote URL loaded by the Electron window is NOT controlled here.
# It is resolved at build-time via resources/app-config.json (see electron/README.md).
# In dev mode, Electron always loads localhost:5173 regardless of CENTRALEATS_URL.
#
# Backend API base URL (used by axios in the React app)
# NOTE: Do NOT add /api suffix — axios routes already include /api/*
VITE_API_BASE_URL=https://centraleatsqa.programacionwebuce.net

# Clerk authentication key
VITE_CLERK_PUBLISHABLE_KEY=pk_test_ZnJlc2gtbGFtYi0yMy5jbGVyay5hY2NvdW50cy5kZXYk