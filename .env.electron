# ═══════════════════════════════════════════════════════════
# CentralEats Desktop — QA Environment
# ═══════════════════════════════════════════════════════════
# Loaded by Vite when running: vite --mode electron
# Used for electron:dev (development against QA backend)
# Backend API base URL (used by axios)
# NOTE: Do NOT add /api suffix — axios routes already include /api/*
VITE_API_BASE_URL=https://centraleatsqa.programacionwebuce.net
# URL loaded by Electron window in production builds targeting QA
CENTRALEATS_URL=https://centraleatsqa.programacionwebuce.net