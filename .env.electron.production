# ═══════════════════════════════════════════════════════════
# CentralEats Desktop — Production Environment
# ═══════════════════════════════════════════════════════════
# Used when building the .exe for production distribution (Vite build env)
#
# NOTE: The remote URL loaded by the Electron window is NOT controlled here.
# It is written into resources/app-config.json by the build script:
#   npm run electron:build:win:prod
# See electron/README.md for details.
#
# Backend API base URL (used by axios in the React app)
VITE_API_BASE_URL=https://centraleatsprod.programacionwebuce.net