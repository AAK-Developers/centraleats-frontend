{
  "name": "centraleats-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:mobile": "vite -c vite.mobile.config.ts --port 5174",
    "build": "tsc -b && vite build",
    "build:dev": "tsc -b && vite build --mode development",
    "build:qa": "tsc -b && vite build --mode qa",
    "build:prod": "tsc -b && vite build --mode production",
    "build:mobile": "tsc -b && vite build -c vite.mobile.config.ts",
    "build:mobile:dev": "npm run build:mobile -- --mode development && npx cap sync",
    "build:mobile:qa": "npm run build:mobile -- --mode qa && npx cap sync",
    "build:mobile:prod": "npm run build:mobile -- --mode production && npx cap sync",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "electron:compile": "tsc -p electron/tsconfig.json && tsc -p electron/tsconfig.preload.json && node -e \"const fs=require('fs'); if(fs.existsSync('dist-electron/preload.js')){fs.renameSync('dist-electron/preload.js','dist-electron/preload.cjs')}\"",
    "electron:dev": "concurrently \"vite --mode electron\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .\"",
    "electron:build": "npm run electron:compile && electron-builder",
    "electron:build:win:qa": "npm run electron:compile && node -e \"require('fs').writeFileSync('resources/app-config.json',JSON.stringify({remoteUrl:'https://centraleatsqa.programacionwebuce.net'},null,2))\" && electron-builder --win",
    "electron:build:win:prod": "npm run electron:compile && node -e \"require('fs').writeFileSync('resources/app-config.json',JSON.stringify({remoteUrl:'https://centraleatsprod.programacionwebuce.net'},null,2))\" && electron-builder --win",
    "electron:build:mac": "npm run electron:compile && electron-builder --mac",
    "electron:build:linux": "npm run electron:compile && electron-builder --linux"
  },
  "dependencies": {
    "@capacitor/splash-screen": "^8.0.1",
    "@chakra-ui/avatar": "^2.3.0",
    "@chakra-ui/react": "^3.35.0",
    "@clerk/clerk-react": "^5.61.8",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@tanstack/react-query": "^5.101.0",
    "axios": "^1.17.0",
    "framer-motion": "^12.40.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.21.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.78.0",
    "react-hot-toast": "^2.6.0",
    "react-icons": "^5.6.0",
    "react-qr-code": "^2.2.0",
    "react-router-dom": "^7.16.0",
    "recharts": "^3.9.2",
    "socket.io-client": "^4.8.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@chromatic-com/storybook": "^5.2.1",
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^10.4.6",
    "@storybook/addon-docs": "^10.4.6",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-mcp": "^0.6.0",
    "@storybook/addon-vitest": "^10.4.6",
    "@storybook/react-vite": "^10.4.6",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.9",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "mockdate": "^3.0.5",
    "msw": "^2.15.0",
    "msw-storybook-addon": "^2.0.7",
    "playwright": "^1.61.1",
    "rollup": "^4.62.2",
    "storybook": "^10.4.6",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^4.1.9",
    "wait-on": "^9.0.10"
  }
}
